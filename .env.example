# The CLI reads environment variables; it does not automatically load this file.
# Export DATABASE_URL in your shell. Never put real credentials in this example.
DATABASE_URL=sqlite:///data/jobscout.db
# Create a private bot via @BotFather; discover your ID with job-scout telegram-chats.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional metered search; only used when providers.brave.enabled is true.
BRAVE_SEARCH_API_KEY=
