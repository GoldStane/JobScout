# The CLI reads exported environment variables; it does not automatically load .env.
# Put the SAME PostgreSQL URI here and in the GitHub Actions DATABASE_URL Secret.
# Copy your provider's actual URI, including sslmode=require or stricter.
# Never commit real credentials. This is a placeholder, not a working database.
DATABASE_URL='postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require'
# Explicit offline/local alternative (ignores DATABASE_URL for this command):
# job-scout --local-db data/jobscout.db jobs

# Use the same Telegram destination locally and in Actions for shared sent history.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional metered search; enable explicitly in discovery configuration.
BRAVE_SEARCH_API_KEY=
